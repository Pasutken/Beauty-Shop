@{
    Layout = "";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #fff0f6;
    }

    .card-box {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(232, 62, 140, 0.15);
    }

    .text-pink {
        color: #E83E8C;
    }

    .btn-pink {
        background-color: #E83E8C;
        color: white;
        border: none;
        border-radius: 10px;
    }

    .btn-pink:hover {
        background-color: #d63384;
        color: white;
    }

    .otp-input {
        width: 55px;
        height: 60px;
        font-size: 24px;
        text-align: center;
        border-radius: 12px;
        border: 1px solid #ddd;
    }

    .otp-input:focus {
        border-color: #E83E8C;
        box-shadow: 0 0 0 0.2rem rgba(232, 62, 140, 0.25);
        outline: none;
    }

    a {
        color: #E83E8C;
        text-decoration: none;
        font-weight: 500;
    }

    a:hover {
        color: #d63384;
    }
</style>

<form asp-controller="Account" asp-action="ResetPassword">
<div class="container d-flex justify-content-center align-items-center" style="min-height:100vh">
    <div class="card-box w-100 text-center" style="max-width:500px;">

        <h3 class="text-pink fw-bold mb-3">ยืนยันรหัส OTP</h3>

        <p class="text-muted mb-4">
            กรุณากรอกรหัส 6 หลักที่ส่งไปยังเบอร์ของคุณ
        </p>

        <div class="d-flex justify-content-between mb-4 px-3">
            <input type="text" maxlength="1" class="otp-input">
            <input type="text" maxlength="1" class="otp-input">
            <input type="text" maxlength="1" class="otp-input">
            <input type="text" maxlength="1" class="otp-input">
            <input type="text" maxlength="1" class="otp-input">
            <input type="text" maxlength="1" class="otp-input">
        </div>

        <div class="d-grid mb-3">
            <button class="btn btn-pink" onclick="window.location.href='ResetPassword'" >
                ยืนยัน
            </button>
        </div>

        <div>
            ไม่ได้รับรหัส ? 
            <a href="#">ส่งอีกครั้ง</a>
        </div>

    </div>
</div>
</form>