@{
    Layout = "";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<style>
    body { background-color: #fff0f6; }
    .card-box {
        background: white;
        padding: 35px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(232, 62, 140, 0.15);
    }
    .text-pink { color: #E83E8C; }
    .btn-pink { background-color: #E83E8C; color: white; border: none; }
    .btn-pink:hover { background-color: #d63384; }
</style>

<form asp-controller="Account" asp-action="OtpForgotPassword">
<div class="container d-flex justify-content-center align-items-center" style="min-height:100vh">
    <div class="card-box w-100" style="max-width:500px;">
        <h3 class="text-center text-pink fw-bold mb-3">ลืมรหัสผ่าน</h3>
        <p class="text-center text-muted mb-4">
            กรอกเบอร์โทรศัพท์เพื่อรับ OTP
        </p>

        <div class="mb-4">
            <label class="form-label">เบอร์โทรศัพท์</label>
            <input type="tel" class="form-control">
        </div>

        <div class="d-grid mb-3">
            <button onclick="window.location.href='OtpForgotPassword'" class="btn btn-pink">
                ส่งรหัส OTP
            </button>
        </div>

        <div class="text-center">
            <a href="Login" class="text-pink fw-semibold">กลับไปหน้าเข้าสู่ระบบ</a>
        </div>
    </div>
</div>
</form>