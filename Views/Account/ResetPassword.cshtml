@{
    Layout = "";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<style>
    body { background-color: #fff0f6; }
    .card-box {
        background: white;
        padding: 35px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(232, 62, 140, 0.15);
    }
    .text-pink { color: #E83E8C; }
    .btn-pink { background-color: #E83E8C; color: white; border: none; }
    .btn-pink:hover { background-color: #d63384; }
</style>

<form asp-controller="Account" asp-action="Login">
<div class="container d-flex justify-content-center align-items-center" style="min-height:100vh">
    <div class="card-box w-100" style="max-width:500px;">
        <h3 class="text-center text-pink fw-bold mb-4">ตั้งรหัสผ่านใหม่</h3>

        <div class="mb-3">
            <label class="form-label">รหัสผ่านใหม่</label>
            <input type="password" class="form-control">
        </div>

        <div class="mb-4">
            <label class="form-label">ยืนยันรหัสผ่าน</label>
            <input type="password" class="form-control">
        </div>

        <div class="d-grid">
            <button onclick="window.location.href='Login'" class="btn btn-pink">
                บันทึกรหัสผ่าน
            </button>
        </div>
    </div>
</div>
</form>