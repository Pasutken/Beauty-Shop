@{
    ViewData["Title"] = "สั่งซื้อสำเร็จ";
    Layout = "~/Views/Shared/_LayoutBeauty.cshtml";
}

<div class="container py-5 text-center" style="min-height: 60vh;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5 mt-5">
                <i class="bi bi-check-circle-fill text-success mb-3" style="font-size: 5rem;"></i>
                <h2 class="fw-bold text-dark">สั่งซื้อสำเร็จ!</h2>
                <p class="text-muted mb-4">ระบบได้รับคำสั่งซื้อและที่อยู่สำหรับจัดส่งของคุณเรียบร้อยแล้ว</p>
                
                <div class="bg-light rounded-3 p-3 mb-4">
                    <p class="mb-1 text-muted small">หมายเลขคำสั่งซื้อล่าสุดคือ</p>
                    <h3 class="fw-bold text-pink m-0">#@ViewBag.OrderId</h3>
                </div>

                <div class="d-flex gap-2 justify-content-center">
                    <a href="/Product/Product" class="btn btn-pink rounded-pill px-4 py-2 fw-bold">ช้อปปิ้งต่อ</a>
                </div>
            </div>
        </div>
    </div>
</div>
