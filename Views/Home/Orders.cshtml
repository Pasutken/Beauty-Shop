@model IEnumerable<Project.Models.Orders> 
@* หมายเหตุ: ถ้าบรรทัดบนสุดมีขีดแดง ให้แก้เป็น Project.Models.Order (ตัด s ออก) ตามชื่อไฟล์ Model ของคุณนะครับ *@
@{
    ViewData["Title"] = "ประวัติการสั่งซื้อของฉัน";
    Layout = "~/Views/Shared/_LayoutBeauty.cshtml";
}

<style>
    .order-section {
        background-color: #f8f9fa; /* พื้นหลังสีเทาอ่อนให้การ์ดดูเด่นขึ้น */
        min-height: 80vh;
    }

    .order-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
        transition: all 0.3s ease;
        background: #fff;
        overflow: hidden;
    }

    .order-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(232, 62, 140, 0.15); /* เงาสีชมพูอ่อนๆ */
    }

    .order-header {
        background-color: #fbfbfb;
        padding: 15px 20px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .order-body {
        padding: 20px;
    }

    .price-tag {
        font-size: 1.6rem;
        color: #E83E8C;
        font-weight: 800;
        line-height: 1;
    }

    .btn-receive {
        background: linear-gradient(135deg, #20c997 0%, #198754 100%);
        color: white;
        border: none;
        transition: 0.3s;
    }

    .btn-receive:hover {
        background: linear-gradient(135deg, #1aa179 0%, #146c43 100%);
        color: white;
        box-shadow: 0 5px 15px rgba(25, 135, 84, 0.3);
        transform: scale(1.02);
    }
</style>

<div class="order-section py-5">
    <div class="container">
        
        <div class="d-flex align-items-center mb-5 pb-3 border-bottom">
            <h2 class="fw-bold text-dark m-0">
                <i class="bi bi-bag-heart-fill text-pink me-2"></i> ประวัติการสั่งซื้อของฉัน
            </h2>
        </div>

        @if (TempData["SuccessMsg"] != null)
        {
            <div class="alert alert-success rounded-pill shadow-sm border-0 mb-4 d-inline-flex align-items-center">
                <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i> 
                <span class="fw-bold">@TempData["SuccessMsg"]</span>
            </div>
        }

        <div class="row g-4">
            
            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-cart-x text-muted" style="font-size: 5rem; opacity: 0.3;"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">คุณยังไม่มีประวัติการสั่งซื้อ</h4>
                    <p class="text-muted mb-4">ตะกร้าของคุณยังว่างเปล่า ลองหาไอเทมโดนใจแล้วมาช้อปกันเถอะ!</p>
                    <a href="/Product/Product" class="btn btn-pink rounded-pill px-5 py-2 fw-bold shadow-sm">
                        <i class="bi bi-shop me-1"></i> ไปช้อปเลย!
                    </a>
                </div>
            }

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="order-card h-100 d-flex flex-column">
                        
                        <div class="order-header">
                            <span class="fw-bold text-dark fs-5">
                                <i class="bi bi-receipt-cutoff text-muted me-1"></i> #@item.OrderId
                            </span>
                            
                            @if(item.Status == "Pending") {
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">รอจัดส่ง</span>
                            } else if(item.Status == "Shipped") {
                                <span class="badge bg-info px-3 py-2 rounded-pill shadow-sm text-white"><i class="bi bi-truck me-1"></i> กำลังจัดส่ง</span>
                            } else if(item.Status == "Completed") {
                                <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm"><i class="bi bi-check2-all me-1"></i> ได้รับแล้ว</span>
                            } else {
                                <span class="badge bg-secondary px-3 py-2 rounded-pill shadow-sm">@item.Status</span>
                            }
                        </div>
                        
                        <div class="order-body flex-grow-1 d-flex flex-column">
                            
                            <p class="text-muted small mb-3 border-bottom pb-3">
                                <i class="bi bi-calendar-event me-1"></i> สั่งซื้อเมื่อ: @item.OrderDate?.ToString("dd MMM yyyy, HH:mm") น.
                            </p>
                            
                            @{
                                var itemsDict = ViewBag.OrderItems as Dictionary<int, List<Project.ViewModels.CartItemViewModel>>;
                                var orderItems = itemsDict != null && itemsDict.ContainsKey(item.OrderId) ? itemsDict[item.OrderId] : new List<Project.ViewModels.CartItemViewModel>();
                            }
                            
                            <div class="bg-light rounded-3 p-3 mb-3 border border-light" style="max-height: 140px; overflow-y: auto;">
                                @if(!orderItems.Any())
                                {
                                    <span class="text-muted small">ไม่พบข้อมูลสินค้า (อาจถูกลบไปแล้ว)</span>
                                }
                                @foreach (var prod in orderItems)
                                {
                                    <div class="d-flex align-items-center mb-2 pb-2 border-bottom border-white">
                                        @if (!string.IsNullOrEmpty(prod.ImageUrl))
                                        {
                                            <img src="~/uploads/@prod.ImageUrl" class="rounded-3 me-3 shadow-sm" style="width: 45px; height: 45px; object-fit: cover;">
                                        }
                                        <div class="flex-grow-1" style="min-width: 0;">
                                            <p class="mb-0 small fw-bold text-dark text-truncate" title="@prod.ProductName">@prod.ProductName</p>
                                            <div class="d-flex justify-content-between align-items-center mt-1">
                                                <small class="text-pink fw-bold">฿@prod.Price.ToString("N0")</small>
                                                <small class="text-muted fw-bold">x @prod.Quantity</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="mb-4 mt-auto border-top pt-3">
                                <small class="text-muted d-block fw-bold mb-1">ยอดชำระสุทธิ</small>
                                <span class="price-tag">฿@item.TotalAmount.ToString("N2")</span>
                            </div>

                            <div class="pt-2">
                                @if (item.Status == "Shipped")
                                {
                                    <form action="/Home/ReceiveOrder" method="post" class="m-0">
                                        <input type="hidden" name="orderId" value="@item.OrderId" />
                                        <button type="submit" class="btn btn-receive rounded-pill w-100 fw-bold py-2 shadow-sm">
                                            <i class="bi bi-box-seam me-1"></i> ฉันได้รับสินค้าแล้ว
                                        </button>
                                    </form>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <div class="bg-light text-center rounded-pill py-2 text-warning fw-bold border border-warning border-opacity-25 shadow-sm" style="font-size: 0.9rem;">
                                        <i class="bi bi-hourglass-split me-1"></i> ร้านกำลังเตรียมจัดส่ง...
                                    </div>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <div class="bg-light text-center rounded-pill py-2 text-success fw-bold border border-success border-opacity-25 shadow-sm" style="font-size: 0.9rem;">
                                        <i class="bi bi-stars me-1"></i> การสั่งซื้อเสร็จสมบูรณ์
                                    </div>
                                }
                            </div>

                        </div>

                    </div>
                </div>
            }

        </div>
    </div>
</div>