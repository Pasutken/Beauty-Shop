@model Project.ViewModels.ProductViewModels
@{
    Layout = "~/Views/Shared/_LayoutBeauty.cshtml";
}

<div class="container d-flex justify-content-center mt-5 mb-5">
    <div class="card shadow-sm border-0 w-100 p-4" style="max-width:700px; border-radius: 15px;">
        <h3 class="text-center text-pink fw-bold mb-4">✏️ แก้ไขสินค้า</h3>

        <form asp-controller="Product" asp-action="EditProduct" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="ProductId" />
            
            <div class="row mb-3">
                <div class="col-md-8">
                    <label class="form-label fw-bold">ชื่อสินค้า <span class="text-danger">*</span></label>
                    <input asp-for="ProductName" class="form-control" required />
                </div>
                <div class="col-md-4 mt-3 mt-md-0">
                    <label class="form-label fw-bold">แบรนด์ (Brand)</label>
                    <input asp-for="Brand" class="form-control" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">ราคา (บาท) <span class="text-danger">*</span></label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">จำนวนสต็อก</label>
                    <input asp-for="Stock" type="number" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-pink">หมวดหมู่สินค้า</label>
                    <select asp-for="CategoryId" class="form-select border-pink">
                        <option value="">-- เลือกหมวดหมู่ --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories as List<Project.Models.Category>)
                            {
                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">รายละเอียดสินค้า</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-pink"><i class="bi bi-image"></i> อัปเดตรูปภาพสินค้า</label>
                <p class="text-muted small mb-2">(ถ้าไม่ต้องการเปลี่ยนรูป ไม่ต้องอัปโหลดใหม่)</p>
                
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-3">
                        <img src="~/uploads/@Model.ImageUrl" alt="Current Image" style="height: 120px; border-radius: 8px; border: 1px solid #ddd;" />
                    </div>
                }
                
                <input asp-for="ImageFile" type="file" class="form-control border-pink" accept="image/*" />
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a href="/Product/MyStore" class="btn btn-light px-4">ยกเลิก</a>
                <button type="submit" class="btn btn-pink px-4">
                    <i class="bi bi-save me-1"></i> บันทึกการแก้ไข
                </button>
            </div>
        </form>
    </div>
</div>